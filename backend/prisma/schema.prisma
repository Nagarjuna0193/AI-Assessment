// Phase 4.6: interviews split into interview_templates (the JD/role, shared
// across candidates) + candidate_sessions (one invited candidate's actual
// attempt). See docs/DECISIONS.md for the migration from the Phase 1/2
// single `interviews` table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  ADMIN
  REVIEWER
}

enum CreditTransactionType {
  GRANT
  DEDUCTION
}

enum QuestionMode {
  AI
  MANUAL
}

// Candidate's answer mode for a session — same TEXT/VOICE concept the old
// Interview.mode carried.
enum SessionMode {
  TEXT
  VOICE
}

// INVITED replaces the old SCHEDULED: a session exists (credit already
// deducted) but the candidate hasn't opened the invite link yet.
enum SessionStatus {
  INVITED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Candidate {
  id                 String    @id @default(uuid())
  fullName           String    @map("full_name")
  email              String    @unique
  phone              String?
  resumeText         String?   @map("resume_text")
  resumeUrl          String?   @map("resume_url")
  // DPDP: when this candidate's personal data is due for deletion/anonymization.
  dataRetentionUntil DateTime? @map("data_retention_until")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  consentRecords ConsentRecord[]

  @@map("candidates")
}

// The JD/role a recruiter is hiring for. Created once by an org admin;
// many candidate_sessions (one per invited candidate) attach to it.
model InterviewTemplate {
  id                 String       @id @default(uuid())
  orgId              String       @map("org_id")
  roleName           String       @map("role_name")
  // Free-text internal requisition/job identifier — no ATS integration in
  // this phase, so it's not a foreign key to anything. See docs/DECISIONS.md.
  jobId              String?      @map("job_id")
  jobDescriptionText String       @map("job_description_text")
  questionMode       QuestionMode @default(AI) @map("question_mode")
  // Fixed question set, only populated/used when questionMode = MANUAL.
  manualQuestions    Json?        @map("manual_questions")
  // Nullable: only org_users create templates going forward; best-effort
  // migrated (Phase 4.5-and-earlier) data has no real creator to attribute.
  createdByOrgUserId String?      @map("created_by_org_user_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  organization      Organization       @relation(fields: [orgId], references: [id])
  createdByOrgUser  OrgUser?           @relation(fields: [createdByOrgUserId], references: [id])
  candidateSessions CandidateSession[]

  @@index([orgId])
  @@map("interview_templates")
}

// One invited candidate's attempt against a template — this is the new
// parent of questions/responses/evaluations, replacing the old Interview.
model CandidateSession {
  id                 String        @id @default(uuid())
  templateId         String        @map("template_id")
  // Denormalized from the template for single-table org-scoped queries
  // (dashboard list/detail) without a join.
  orgId              String        @map("org_id")
  candidateName      String        @map("candidate_name")
  email              String
  // Opaque, unguessable candidate-facing identifier — the candidate flow
  // (consent, resume upload, interview, voice) is addressed by this token,
  // never by the internal id reviewers use. See docs/DECISIONS.md.
  inviteToken        String        @unique @map("invite_token")
  status             SessionStatus @default(INVITED)
  mode               SessionMode   @default(TEXT)
  resumeFileRef      String?       @map("resume_file_ref")
  resumeText         String?       @map("resume_text")
  // 0-100 LLM-judged resume-vs-JD match score + short rationale.
  resumeJdScore      Int?          @map("resume_jd_score")
  resumeJdRationale  String?       @map("resume_jd_rationale")
  consentRecordId    String?       @unique @map("consent_record_id")
  startedAt          DateTime?     @map("started_at")
  completedAt        DateTime?     @map("completed_at")
  // DPDP: when this session's data is due for deletion/anonymization.
  dataRetentionUntil DateTime?     @map("data_retention_until")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  template          InterviewTemplate  @relation(fields: [templateId], references: [id])
  organization      Organization       @relation(fields: [orgId], references: [id])
  consentRecord     ConsentRecord?     @relation(fields: [consentRecordId], references: [id])
  questions         Question[]
  responses         Response[]
  evaluations       Evaluation[]
  creditTransaction CreditTransaction?

  @@index([orgId])
  @@index([templateId])
  @@map("candidate_sessions")
}

model Organization {
  id            String   @id @default(uuid())
  name          String
  creditBalance Int      @default(0) @map("credit_balance")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  orgUsers           OrgUser[]
  interviewTemplates InterviewTemplate[]
  candidateSessions  CandidateSession[]
  creditTransactions CreditTransaction[]

  @@map("organizations")
}

model OrgUser {
  id        String   @id @default(uuid())
  email     String   @unique
  orgId     String   @map("org_id")
  role      OrgRole  @default(REVIEWER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [orgId], references: [id])
  loginOtps          LoginOtp[]
  interviewTemplates InterviewTemplate[]

  @@index([orgId])
  @@map("org_users")
}

// DPDP-adjacent audit note: this is login infrastructure, not candidate
// personal data — kept separate from audit_log (which tracks AI decisions).
model LoginOtp {
  id         String    @id @default(uuid())
  orgUserId  String    @map("org_user_id")
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  orgUser OrgUser @relation(fields: [orgUserId], references: [id])

  @@index([orgUserId])
  @@map("login_otps")
}

// The credits audit trail (not just a balance counter) — every grant and
// every per-session deduction is a row here. Deduction moved from
// template-creation to session-creation in Phase 4.6 — see docs/DECISIONS.md.
model CreditTransaction {
  id        String                @id @default(uuid())
  orgId     String                @map("org_id")
  amount    Int
  type      CreditTransactionType
  sessionId String?               @unique @map("session_id")
  // Ops email/identifier for a grant, or "system" for an automatic deduction.
  addedBy   String                @map("added_by")
  createdAt DateTime              @default(now()) @map("created_at")

  organization Organization      @relation(fields: [orgId], references: [id])
  session      CandidateSession? @relation(fields: [sessionId], references: [id])

  @@index([orgId])
  @@map("credit_transactions")
}

model Question {
  id               String   @id @default(uuid())
  sessionId        String   @map("session_id")
  orderIndex       Int      @map("order_index")
  questionText     String   @map("question_text")
  // Model + prompt version that generated this question (or "manual" when
  // copied from the template's fixed question set), for auditability.
  generatedByModel String?  @map("generated_by_model")
  createdAt        DateTime @default(now()) @map("created_at")

  session   CandidateSession @relation(fields: [sessionId], references: [id])
  responses Response[]

  @@index([sessionId])
  @@map("questions")
}

model Response {
  id               String    @id @default(uuid())
  sessionId        String    @map("session_id")
  questionId       String    @map("question_id")
  responseText     String?   @map("response_text")
  responseAudioUrl String?   @map("response_audio_url")
  submittedAt      DateTime? @map("submitted_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  session  CandidateSession @relation(fields: [sessionId], references: [id])
  question Question         @relation(fields: [questionId], references: [id])

  @@index([sessionId])
  @@index([questionId])
  @@map("responses")
}

model Evaluation {
  id                   String    @id @default(uuid())
  sessionId            String    @map("session_id")
  overallScore         Decimal?  @map("overall_score") @db.Decimal(5, 2)
  // Structured per-criterion scores/notes.
  scorecard            Json?     @map("scorecard")
  summaryText          String?   @map("summary_text")
  modelVersion         String?   @map("model_version")
  humanReviewRequested Boolean   @default(false) @map("human_review_requested")
  humanReviewNotes     String?   @map("human_review_notes")
  evaluatedAt          DateTime? @map("evaluated_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  session CandidateSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("evaluations")
}

model ConsentRecord {
  id                 String    @id @default(uuid())
  candidateId        String    @map("candidate_id")
  // e.g. "data_processing", "recording", "ai_evaluation"
  consentType        String    @map("consent_type")
  // Version identifier of the consent text shown to the candidate.
  consentTextVersion String    @map("consent_text_version")
  consentGivenAt     DateTime  @map("consent_given_at")
  consentWithdrawnAt DateTime? @map("consent_withdrawn_at")
  ipAddress          String?   @map("ip_address")
  createdAt          DateTime  @default(now()) @map("created_at")

  candidate        Candidate         @relation(fields: [candidateId], references: [id])
  candidateSession CandidateSession?

  @@index([candidateId])
  @@map("consent_records")
}

model AuditLog {
  id           String   @id @default(uuid())
  // "candidate" | "recruiter" | "system"
  actorType    String   @map("actor_type")
  actorId      String?  @map("actor_id")
  // e.g. "question_generated", "evaluation_generated", "consent_recorded"
  action       String
  // e.g. "candidate_session" | "evaluation" | "question" | "consent_record"
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  modelVersion String?  @map("model_version")
  promptRef    String?  @map("prompt_ref")
  inputRef     String?  @map("input_ref")
  outputRef    String?  @map("output_ref")
  purpose      String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_log")
}
