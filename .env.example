# Copy to .env and fill in real values. Never commit .env.

# Anthropic API (question generation + evaluation)
ANTHROPIC_API_KEY=

# Postgres (Supabase or Railway)
DATABASE_URL=

# Voice: STT/TTS provider — OpenAI (Whisper + TTS), decided in Phase 4 —
# see docs/DECISIONS.md. Same key covers both audio.transcriptions and
# audio.speech calls.
STT_TTS_PROVIDER_API_KEY=

# Auth (email/OTP) — org_user login, Phase 4.5. See docs/DECISIONS.md.
# Resend API key for sending OTP emails; leave blank in dev to log codes to
# the console instead.
AUTH_EMAIL_PROVIDER_API_KEY=
AUTH_EMAIL_FROM=no-reply@ai-interview-bot.local

# Session JWT signing secret — set a long random value in any real environment.
JWT_SECRET=
JWT_EXPIRES_IN=7d
OTP_TTL_MINUTES=10

# Shared secret for ops-only endpoints (org/org_user provisioning, credit
# grants) — sent as the x-ops-key header. Never expose to org_users/frontend.
OPS_API_KEY=

# Frontend origin allowed to send credentialed (cookie) requests to this API.
FRONTEND_URL=http://localhost:3000

# Resume file storage (Phase 4.6) — Supabase Storage, same vendor as
# Postgres. See docs/DECISIONS.md. Leave blank in dev to fall back to local
# disk (LOCAL_UPLOADS_DIR) instead of a real bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RESUME_BUCKET=resumes
LOCAL_UPLOADS_DIR=uploads
